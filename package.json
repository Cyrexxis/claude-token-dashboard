{
  "name": "token-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "test": "bun test",
    "test:mod": "claude plugin test ./plugin",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "biome check .",
    "check:network": "bun scripts/check-network.ts",
    "scan": "bun server/src/cli.ts scan",
    "watch": "bun server/src/cli.ts watch",
    "stats": "bun server/src/cli.ts stats",
    "reprice": "bun server/src/cli.ts reprice",
    "serve": "bun server/src/cli.ts serve",
    "setup": "bun server/src/cli.ts setup",
    "update": "bun server/src/cli.ts update",
    "uninstall": "bun server/src/cli.ts uninstall",
    "build:web": "bun run --cwd web build",
    "dev": "bun run --filter '@td/server' --filter '@td/web' dev",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
